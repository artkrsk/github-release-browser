{
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "composer check"
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "pnpm test"
      },
      {
        "action": "composer check"
      },
      {
        "action": "pnpm test:integration"
      }
    ]
  }
}
