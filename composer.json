{
  "name": "arts/github-release-browser",
  "description": "Reusable GitHub release browser with PHP backend & React frontend",
  "license": "GPL-3.0-or-later",
  "type": "library",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "captainhook/captainhook": "^5.23",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1.2",
    "ergebnis/composer-normalize": "^2.44",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "2.1.x-dev",
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "3.x-dev",
    "szepeviktor/phpstan-wordpress": "2.x-dev",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Arts\\GH\\ReleaseBrowser\\": "src/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "captainhook/captainhook": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "vendor/bin/captainhook install -f -s"
    ],
    "post-update-cmd": [
      "vendor/bin/captainhook install -f -s"
    ],
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ],
    "fix": "@phpcbf",
    "phpcbf": "vendor/bin/phpcbf --standard=.phpstan/phpcs.xml",
    "phpcs": "vendor/bin/phpcs --standard=.phpstan/phpcs.xml",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
    "phpstan:baseline": "phpstan analyse --memory-limit=1G --generate-baseline",
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-html coverage/php",
    "test:integration": "vendor/bin/phpunit --testsuite Integration",
    "test:unit": "vendor/bin/phpunit --testsuite Unit"
  }
}
